      <img src="/images/city-2.webp" alt="Turbine and Generator Services in Port Harcourt and Rivers State" width="800" height="533" style="width:100%;height:100%;object-fit:cover;display:block;" loading="eager" fetchpriority="high">
    </div>
  </div>
</section>
<style>
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr !important; } .hero-img { max-height: 320px; } }
